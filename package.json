{
  "name": "scorched-3d",
  "version": "0.0.0",
  "private": true,
  "description": "Scorched 3D — a browser remake of the classic Scorched Earth artillery game.",
  "packageManager": "yarn@4.9.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-app-version.mjs",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@changesets/cli": "^2.0.0",
    "@changesets/get-release-plan": "4.0.16",
    "turbo": "2.5.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
